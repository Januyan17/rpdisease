rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Development: allow all read/write (INSECURE - do not use in production)
    match /{document=**} {
      allow read, write: if true;
    }

    // Production example (uncomment and remove the block above when ready):
    // match /users/{userId} {
    //   allow read, write: if request.auth != null && request.auth.uid == userId;
    // }
    // match /users/{userId}/dogs/{dogId} {
    //   allow read, write: if request.auth != null && request.auth.uid == userId;
    // }
  }
}
